CROW_STT_LANGUAGE='zh'

CROW_VOICE_PROVIDER='system'
CROW_CLOUD_REALTIME_ENABLED='false'
CROW_OPENAI_API_KEY=''
CROW_OPENAI_BASE_URL='https://api.openai.com'
# Optional local-only workaround when DNS/proxy resolves api.openai.com incorrectly.
# Leave empty in production and Cloud Run.
CROW_OPENAI_RESOLVE_IP=''
CROW_OPENAI_DISABLE_PROXY='false'
CROW_OPENAI_AGENT_MODEL='gpt-4.1-mini'
CROW_STT_PROVIDER='cloud'
CROW_CLOUD_BASE_URL='http://127.0.0.1:18089'
CROW_OPENAI_STT_MODEL='gpt-4o-mini-transcribe'
CROW_STT_FALLBACK='system'
CROW_TTS_PROVIDER='cloud'
CROW_OPENAI_TTS_MODEL='gpt-4o-mini-tts'
CROW_OPENAI_TTS_VOICE='marin'
CROW_TTS_FALLBACK='system'
CROW_VOICE_AUDIO_STREAMING='true'
CROW_OPENAI_REALTIME_MODEL='gpt-realtime'
CROW_OPENAI_REALTIME_TRANSCRIPTION_MODEL='gpt-4o-mini-transcribe'
CROW_OPENAI_REALTIME_VOICE='marin'
CROW_OPENAI_REALTIME_TURN_DETECTION='semantic_vad'
CROW_OPENAI_REALTIME_BASE_URL='https://api.openai.com'

CROW_TTS_VOICE=''
CROW_TTS_STREAMING='true'

CROW_ISLAND_SCREEN='builtin'
CROW_ISLAND_HOTKEY='ctrl+option+space'
CROW_ISLAND_IDLE_CLOSE_SECONDS='8'
CROW_ISLAND_VOICE_CONTINUE_DELAY_SECONDS='0.75'
CROW_ISLAND_VOICE_NO_SPEECH_CLOSE_SECONDS='12'

# Built-in Codex adapter. Leave CROW_CODEX_PATH empty to auto-detect `codex`.
CROW_CODEX_PATH=''
CROW_CODEX_CWD=''
CROW_CODEX_MODEL=''
CROW_CODEX_REUSE_CONTEXT='true'
CROW_CODEX_APPROVAL_POLICY='on-request'
CROW_CODEX_SANDBOX='workspace-write'

# Legacy command adapters, only used as fallbacks or for custom executors.
CROW_CODEX_COMMAND=''
CROW_HERMES_COMMAND=''
CROW_MAIL_COMMAND=''
