# Conversation mode: "local" (default) calls the model provider directly from the
# crowd daemon with your own key; "cloud" uses a Crow Cloud server (CROW_CLOUD_BASE_URL).
CROW_AGENT_MODE='local'
# openai | anthropic | deepseek | moonshot | qwen | glm | openrouter | ollama | custom
CROW_LLM_PROVIDER='openai'
# Leave empty to use the provider default. Required for "custom".
CROW_LLM_BASE_URL=''
# Leave empty to use the provider default (openai, anthropic, deepseek); required otherwise.
CROW_LLM_MODEL=''
# Prefer setting the key in the app (stored in Keychain). For openai, CROW_OPENAI_API_KEY also works.
CROW_LLM_API_KEY=''
# Max model requests per turn in local mode.
CROW_AGENT_MAX_STEPS='40'
CROW_MEMORY_ENABLED='true'
# Local mode uses HTTP(S)_PROXY, else the macOS system proxy. 'true' connects directly.
CROW_LLM_DISABLE_PROXY='false'
# OpenAI API: empty = automatic (Chat Completions, Responses when a model needs it), or 'chat' / 'responses'.
CROW_LLM_API=''
# Reasoning effort on the Responses API (default low, for quick spoken replies).
CROW_LLM_REASONING_EFFORT=''
# Approval level: cautious (ask every action), balanced (once per task; every
# terminal command) or relaxed (once, then allowed for the grant minutes).
CROW_APPROVAL_LEVEL='balanced'
# Optional per-type overrides: every_turn, before_acting, once or never; empty or
# 'auto' follows the level. Terminal 'never' is applied as 'once'.
CROW_APPROVAL_COMPUTER=''
CROW_APPROVAL_TERMINAL=''
CROW_APPROVAL_EXECUTOR=''
CROW_APPROVAL_FILE_WRITE=''
CROW_APPROVAL_GRANT_MINUTES='30'
# Computer use is off until enabled in Settings (shows a risk notice).
CROW_COMPUTER_USE_ENABLED='false'
CROW_COMPUTER_SEE_ONLY='false'

CROW_STT_LANGUAGE='zh'

CROW_VOICE_PROVIDER='system'
CROW_CLOUD_REALTIME_ENABLED='false'
CROW_OPENAI_API_KEY=''
CROW_OPENAI_BASE_URL='https://api.openai.com'
# Optional local-only workaround when DNS/proxy resolves api.openai.com incorrectly.
# Leave empty in production and Cloud Run.
CROW_OPENAI_RESOLVE_IP=''
CROW_OPENAI_DISABLE_PROXY='false'
CROW_OPENAI_AGENT_MODEL='gpt-4.1-mini'
CROW_STT_PROVIDER='cloud'
CROW_CLOUD_BASE_URL='http://127.0.0.1:18089'
CROW_OPENAI_STT_MODEL='gpt-4o-transcribe'
CROW_STT_FALLBACK='system'
# Comma-separated names and terms speech recognition should get right.
CROW_STT_VOCABULARY=''
# Hold or tap to dictate into any app; 'off' disables it.
CROW_DICTATION_HOTKEY='ctrl+option+d'
# macOS voice processing (noise suppression, echo cancellation, gain control).
CROW_VOICE_PROCESSING='true'
# Ignore speech much quieter than the main speaker, e.g. a TV or people across the room.
CROW_VOICE_NEAR_FIELD='true'
# Longest voice capture in seconds before Crow stops listening on its own.
CROW_VOICE_MAX_SECONDS='60'
# Talk over Crow to interrupt it while it thinks or speaks.
CROW_VOICE_BARGE_IN='true'
CROW_TTS_PROVIDER='cloud'
CROW_OPENAI_TTS_MODEL='gpt-4o-mini-tts'
CROW_OPENAI_TTS_VOICE='marin'
CROW_TTS_FALLBACK='system'
CROW_VOICE_AUDIO_STREAMING='true'
CROW_OPENAI_REALTIME_MODEL='gpt-realtime'
CROW_OPENAI_REALTIME_TRANSCRIPTION_MODEL='gpt-4o-transcribe'
CROW_OPENAI_REALTIME_VOICE='marin'
CROW_OPENAI_REALTIME_TURN_DETECTION='semantic_vad'
CROW_OPENAI_REALTIME_BASE_URL='https://api.openai.com'

CROW_TTS_VOICE=''
CROW_TTS_STREAMING='true'

CROW_ISLAND_SCREEN='builtin'
CROW_ISLAND_HOTKEY='ctrl+option+space'
CROW_ISLAND_IDLE_CLOSE_SECONDS='8'
CROW_ISLAND_VOICE_CONTINUE_DELAY_SECONDS='0.75'
CROW_ISLAND_VOICE_NO_SPEECH_CLOSE_SECONDS='12'

# Built-in Codex adapter. Leave CROW_CODEX_PATH empty to auto-detect `codex`.
CROW_CODEX_PATH=''
CROW_CODEX_CWD=''
CROW_CODEX_MODEL=''
CROW_CODEX_REUSE_CONTEXT='true'
CROW_CODEX_APPROVAL_POLICY='on-request'
CROW_CODEX_SANDBOX='workspace-write'

# Legacy command adapters, only used as fallbacks or for custom executors.
CROW_CODEX_COMMAND=''
CROW_HERMES_COMMAND=''
CROW_MAIL_COMMAND=''
